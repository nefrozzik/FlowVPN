<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Доступ к сети для прокси-соединений -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ForegroundService — обязательно для VPN на API 26+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- API 34+: тип foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Уведомления — API 33+ требует runtime permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Камера для сканирования QR-кодов подписок -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Запрос списка установленных приложений для Split Tunneling (per-app VPN) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- Доступ к состоянию сети для определения типа соединения -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Wake lock для стабильной работы в background -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FlowVpnApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlowVPN"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FlowVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Описание использования foregroundServiceType="specialUse" для Google Play.
            Требуется для публикации приложений с VPN-функциональностью.
        -->
        <!-- Быстрый переключатель в шторке (Quick Settings Tile) -->
        <service
            android:name=".service.FlowVpnTileService"
            android:icon="@android:drawable/ic_lock_lock"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FileProvider для безопасного экспорта логов и отчетов об ошибках -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
